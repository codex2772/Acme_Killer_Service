# Override default variables for your environment
# Copy this file to terraform.tfvars and update values

aws_region  = "ap-south-1"
environment = "prod"
app_name    = "jewel-erp"

# Networking
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["ap-south-1a", "ap-south-1b"]

# ECS Configuration
container_port   = 8080
container_cpu    = 512    # 0.5 vCPU
container_memory = 1024   # 1 GB
desired_count    = 1

# RDS MySQL
db_instance_class = "db.t3.micro"
db_name           = "jewelerpdb"
db_username       = "jeweladmin"
db_password       = "CHANGE_ME_STRONG_PASSWORD"

# JWT — generate with: openssl rand -hex 32
# Use hex, not base64: RDS rejects / @ " and space in passwords, and the CI
# heredoc is shell-expanded, so $ in a value silently truncates it.
jwt_secret = "CHANGE_ME_MIN_32_CHARS_STRONG_SECRET"

# Razorpay — Dashboard > Settings > API Keys.
# webhook_secret is self-chosen and must match Dashboard > Settings > Webhooks.
razorpay_key_id         = "rzp_test_CHANGE_ME"
razorpay_key_secret     = "CHANGE_ME"
razorpay_webhook_secret = "CHANGE_ME"

